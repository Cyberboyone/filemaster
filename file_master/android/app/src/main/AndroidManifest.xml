<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Internet is required by the AdMob SDK. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Camera is used by Scan to PDF. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- File browser access to device storage (Android 11+ "All files access"). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>
    <!-- Legacy storage permissions for Android 10 and older. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <application
        android:label="File Master"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- AdMob test app ID - replace ca-app-pub-3940256099942544~3347511713
             with the real App ID from AdMob console before release. -->